# Base URL for the backend API. In local dev, Vite proxies /api to the
# backend (see vite.config.js), so the default below works out of the box.
VITE_API_URL=/api

# Optional: only needed if the Socket.IO server runs on a different origin
# than the API (e.g. API on Vercel, realtime on Render/Railway). Leave unset
# to connect same-origin.
# VITE_SOCKET_URL=https://your-realtime-host.example.com
