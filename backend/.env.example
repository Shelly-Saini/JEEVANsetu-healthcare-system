# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/jeevansetu

# ── CORS ─────────────────────────────────────────────────────────────────────
# The frontend origin allowed to call this API with credentials
ALLOWED_ORIGIN=http://localhost:5173

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate real secrets for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Seed data ────────────────────────────────────────────────────────────────
# Shared demo password for every seeded account (see README → Demo logins)
SEED_DEMO_PASSWORD=Demo@1234

# ── Realtime / scheduler ─────────────────────────────────────────────────────
# Set to 'true' to run the Socket.IO server + snapshot scheduler when
# NODE_ENV=production (e.g. when deploying to a persistent host like
# Render/Railway rather than Vercel serverless functions — see README).
ENABLE_HTTP_SERVER=false
ENABLE_SNAPSHOT_SCHEDULER=false
